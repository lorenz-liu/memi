# Cloud Run defaults for memi-api. Sourced by deploy.sh.
# Override on the command line, e.g. GOOGLE_CLOUD_REGION=europe-west1 ./infra/deploy/deploy.sh

CLOUD_RUN_SERVICE=memi-api
GOOGLE_CLOUD_REGION=us-central1
CLOUD_RUN_MEMORY=512Mi
CLOUD_RUN_CPU=1
CLOUD_RUN_TIMEOUT=120
CLOUD_RUN_MAX_INSTANCES=3
CLOUD_RUN_CONCURRENCY=8
CLOUD_RUN_SECRET=GROQ_API_KEY
